{
  "name": "easy-pedia-mcqs",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "Easy Pedia MCQs - pediatric MCQs app (React web + Capacitor mobile)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/lib/quiz.test.js",
    "mobile:sync": "npm run build && npx cap sync android",
    "mobile:android": "npx cap run android",
    "mobile:open": "npx cap open android",
    "mobile:build:apk": "npm run mobile:sync && cd android && gradlew.bat assembleRelease && cd ..",
    "deploy:web": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "^7.1.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capgo/capacitor-social-login": "^7.20.0",
    "firebase": "^11.2.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.548.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.2.0"
  }
}
