// Realtime Database rules for easy-pedia.
//
// This is the WHOLE ruleset. A rules deploy replaces everything, so anything
// missing here is gone from the live database — which is why the top-level
// defaults and every .indexOn are repeated below rather than assumed.
//
// The shape is: a permissive default that matches how the old Sketchware app
// has always worked, with tighter rules on the specific nodes that can hurt
// someone. A child rule overrides its parent, so each block below is a
// restriction carved out of the default.
{
  "rules": {
    // The original rule, kept as-is. Every node without its own rule below
    // behaves exactly as it does today, so the old Android app is unaffected.
    ".read": "auth.uid != null",
    ".write": "auth.uid != null",

    // ---------------------------------------------------------------- indexes
    // Without these the query still works, but Firebase downloads the whole
    // node and filters in the browser. quizqq is the big one.
    "quizqq": {
      ".indexOn": ["key", "category1", "category2", "bchap", "bsci", "source"]
    },
    "resume": {
      ".indexOn": ["uid"]
    },
    "feedback": {
      ".indexOn": ["key"]
    },

    // ------------------------------------------------------------- AI usage
    // Daily Gemini request counts, written only by the aiStudy function (the
    // Admin SDK skips rules) and shown to admins on the AI Study page.
    "aiUsage": {
      ".read": "auth.token.email === 'gussaay@gmail.com' || auth.token.email === 'malazmuzamil55@gmail.com' || root.child('quizusers').child(auth.uid).child('admin').val() === 'true'",
      ".write": false
    },

    // ------------------------------------------------------------- textbooks
    // Indexed textbook passages for the AI helper (tools/books/index-books.mjs
    // writes them with the Firebase CLI, the aiStudy function reads them; both
    // skip rules). Admins may see which books exist; nobody reads the text
    // through the app, since the books are copyrighted.
    "books": {
      ".read": false,
      ".write": false,
      "list": {
        ".read": "auth.token.email === 'gussaay@gmail.com' || auth.token.email === 'malazmuzamil55@gmail.com' || root.child('quizusers').child(auth.uid).child('admin').val() === 'true'"
      }
    },

    // ------------------------------------------------------- updates & pushes
    // Everyone reads which version to run; only admins decide it. Without this,
    // any signed-in user could point every installed app at a bundle of their
    // choosing.
    "update": {
      ".read": "auth.uid != null",
      ".write": "auth.token.email === 'gussaay@gmail.com' || auth.token.email === 'malazmuzamil55@gmail.com' || root.child('quizusers').child(auth.uid).child('admin').val() === 'true'"
    },

    // Only admins may queue a push. Nobody needs to read the queue except the
    // GitHub Actions sender, which uses the service account and bypasses rules
    // entirely.
    "push_outbox": {
      ".read": "auth.token.email === 'gussaay@gmail.com' || auth.token.email === 'malazmuzamil55@gmail.com' || root.child('quizusers').child(auth.uid).child('admin').val() === 'true'",
      ".write": "auth.token.email === 'gussaay@gmail.com' || auth.token.email === 'malazmuzamil55@gmail.com' || root.child('quizusers').child(auth.uid).child('admin').val() === 'true'"
    },

    // A device token is a way to send that person notifications, so each user
    // writes only their own and nobody can read the whole list. The admin
    // panel's device count is what the parent .read is for.
    "push_tokens": {
      ".read": "auth.token.email === 'gussaay@gmail.com' || auth.token.email === 'malazmuzamil55@gmail.com' || root.child('quizusers').child(auth.uid).child('admin').val() === 'true'",
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },

    // ------------------------------------------------------------- flashcards
    // The catalogue: everyone browses, only admins write.
    "flashcategory": {
      ".read": "auth.uid != null",
      ".write": "auth.token.email === 'gussaay@gmail.com' || auth.token.email === 'malazmuzamil55@gmail.com' || root.child('quizusers').child(auth.uid).child('admin').val() === 'true'"
    },
    "flashbooks": {
      ".read": "auth.uid != null",
      ".write": "auth.token.email === 'gussaay@gmail.com' || auth.token.email === 'malazmuzamil55@gmail.com' || root.child('quizusers').child(auth.uid).child('admin').val() === 'true'"
    },
    "flashdecks": {
      ".read": "auth.uid != null",
      ".write": "auth.token.email === 'gussaay@gmail.com' || auth.token.email === 'malazmuzamil55@gmail.com' || root.child('quizusers').child(auth.uid).child('admin').val() === 'true'"
    },

    // The cards themselves. Deliberately NOT under `flashcards`, which the old
    // Android app already uses for per-topic scores. No .indexOn is needed: a
    // deck is always read whole, by its id.
    "flashcard_items": {
      ".read": "auth.uid != null",
      ".write": "auth.token.email === 'gussaay@gmail.com' || auth.token.email === 'malazmuzamil55@gmail.com' || root.child('quizusers').child(auth.uid).child('admin').val() === 'true'"
    },

    // Which mnemonic covers each flashcard: mnemonic_links/<deck>/<card>/<mDeck~mCard>.
    // A reverse index of the `links` on mnemonic cards, read with a deck.
    "mnemonic_links": {
      ".read": "auth.uid != null",
      ".write": "auth.token.email === 'gussaay@gmail.com' || auth.token.email === 'malazmuzamil55@gmail.com' || root.child('quizusers').child(auth.uid).child('admin').val() === 'true'"
    },

    // Which box each card is in, and the streak totals. Private to each person,
    // and only ever read or written under their own uid by the app.
    "flashprogress": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },
    "flashstats": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },

    // ------------------------------------------------------- quiz progress
    // Which questions you have answered and whether you got them right, plus
    // the per-quiz and per-topic totals the performance dashboard reads. All
    // three are private: nobody else needs them, and they say a lot about how
    // someone is doing. The leaderboard still lives in `quizlead`, which is
    // deliberately readable by everyone.
    "quizhistory": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },
    "quizstats": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },
    "quizcats": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },
    // Every finished attempt of each quiz (questions and choices), so their
    // answers can be reviewed again later and on another device.
    "quizreview": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },

    // Practice quizzes the AI tutor built for you (functions/agent.js writes
    // them; the app only reads, and may delete, its own).
    "aiquiz": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid && !newData.exists()"
      }
    },

    // ------------------------------------------------------------- access
    // Roles, plans, trials, Pro and unlocks (src/lib/access.js). Only the
    // superuser and managers may set them.
    //
    // Why .validate at every depth: the top-level ".write" above already lets
    // every signed-in user write everywhere, and a granted .write cannot be
    // taken back by a deeper rule. A .validate can, because every one on the
    // way down has to pass; it is checked for each value written, so each
    // depth needs its own. Deletes skip .validate, so these stop someone
    // giving themselves access but not someone removing access. Closing that
    // needs the top-level rule tightened, which means listing every node the
    // old Android app writes.
    "access_config": {
      ".validate": "auth.token.email === 'gussaay@gmail.com' || root.child('access').child(auth.uid).child('role').val() === 'manager' || (auth.token.email === 'malazmuzamil55@gmail.com' && !root.child('access').child(auth.uid).child('role').exists())",
      "$field": { ".validate": "auth.token.email === 'gussaay@gmail.com' || root.child('access').child(auth.uid).child('role').val() === 'manager' || (auth.token.email === 'malazmuzamil55@gmail.com' && !root.child('access').child(auth.uid).child('role').exists())" }
    },
    "access": {
      "$uid": {
        ".validate": "auth.token.email === 'gussaay@gmail.com' || root.child('access').child(auth.uid).child('role').val() === 'manager' || (auth.token.email === 'malazmuzamil55@gmail.com' && !root.child('access').child(auth.uid).child('role').exists())",
        "$field": {
          ".validate": "auth.token.email === 'gussaay@gmail.com' || root.child('access').child(auth.uid).child('role').val() === 'manager' || (auth.token.email === 'malazmuzamil55@gmail.com' && !root.child('access').child(auth.uid).child('role').exists())",
          "$a": {
            ".validate": "auth.token.email === 'gussaay@gmail.com' || root.child('access').child(auth.uid).child('role').val() === 'manager' || (auth.token.email === 'malazmuzamil55@gmail.com' && !root.child('access').child(auth.uid).child('role').exists())",
            "$b": {
              ".validate": "auth.token.email === 'gussaay@gmail.com' || root.child('access').child(auth.uid).child('role').val() === 'manager' || (auth.token.email === 'malazmuzamil55@gmail.com' && !root.child('access').child(auth.uid).child('role').exists())",
              "$c": { ".validate": false }
            }
          }
        },
        // Only the superuser makes or changes a manager. (A named child is not
        // covered by the $field rule beside it, so this repeats the manager check.)
        "role": {
          ".validate": "(auth.token.email === 'gussaay@gmail.com' || root.child('access').child(auth.uid).child('role').val() === 'manager' || (auth.token.email === 'malazmuzamil55@gmail.com' && !root.child('access').child(auth.uid).child('role').exists())) && newData.isString() && newData.val().matches(/^(manager|editor|reviewer|pro|user)$/) && (auth.token.email === 'gussaay@gmail.com' || (newData.val() !== 'manager' && data.val() !== 'manager'))"
        }
      }
    },

    // "Request unlock": each person may send their own, as pending; only the
    // superuser and managers approve or decline them.
    "unlock_requests": {
      "$uid": {
        ".validate": "auth.token.email === 'gussaay@gmail.com' || root.child('access').child(auth.uid).child('role').val() === 'manager' || (auth.token.email === 'malazmuzamil55@gmail.com' && !root.child('access').child(auth.uid).child('role').exists()) || auth.uid === $uid",
        "$key": {
          ".validate": "auth.token.email === 'gussaay@gmail.com' || root.child('access').child(auth.uid).child('role').val() === 'manager' || (auth.token.email === 'malazmuzamil55@gmail.com' && !root.child('access').child(auth.uid).child('role').exists()) || (auth.uid === $uid && newData.child('status').val() === 'pending')",
          "$field": {
            ".validate": "auth.token.email === 'gussaay@gmail.com' || root.child('access').child(auth.uid).child('role').val() === 'manager' || (auth.token.email === 'malazmuzamil55@gmail.com' && !root.child('access').child(auth.uid).child('role').exists()) || (auth.uid === $uid && newData.parent().child('status').val() === 'pending')",
            "$deeper": { ".validate": false }
          }
        }
      }
    },

    // ---------------------------------------------------------------- interest
    // Who asked to be told when a coming-soon section opens. Readable by any
    // signed-in user because the page shows the running count and whether you
    // are already on the list; it holds nothing but user ids and timestamps.
    // Each person may only add their own entry.
    "interest": {
      "$section": {
        ".read": "auth.uid != null",
        "$uid": {
          ".write": "auth.uid === $uid"
        }
      }
    }
  }
}
